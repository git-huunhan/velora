{
  "name": "velora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @velora/web",
    "dev:api": "npm run start:dev --workspace @velora/api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build --workspace @velora/web",
    "build:api": "npm run build --workspace @velora/api",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:web": "npm run lint --workspace @velora/web",
    "lint:api": "npm run lint --workspace @velora/api",
    "docs:check": "node scripts/check-docs-encoding.mjs",
    "test:api": "npm run test --workspace @velora/api",
    "test:api:e2e": "npm run test:e2e --workspace @velora/api",
    "test:api:integration": "npm run test:integration --workspace @velora/api",
    "contract:api": "npm run contract:generate --workspace @velora/api",
    "db:generate": "npm run db:generate --workspace @velora/api",
    "db:migrate": "npm run db:migrate --workspace @velora/api",
    "db:seed": "npm run db:seed --workspace @velora/api",
    "db:studio": "npm run db:studio --workspace @velora/api",
    "preview": "npm run preview --workspace @velora/web",
    "storybook": "npm run storybook --workspace @velora/web",
    "build:storybook": "npm run build-storybook --workspace @velora/web"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.18.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.77.0",
    "react-resizable-panels": "^4.12.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
