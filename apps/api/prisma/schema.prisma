generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum UserRole {
  ADMIN
  USER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum TaskType {
  EPIC
  TASK
  BUG
  SUBTASK
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  email         String          @unique
  displayName   String
  avatarUrl     String?
  role          UserRole        @default(USER)
  memberships   ProjectMember[]
  assignedTasks Task[]          @relation("TaskAssignee")
  reportedTasks Task[]          @relation("TaskReporter")
  comments      Comment[]
  activities    Activity[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  key         String          @unique
  name        String
  description String          @default("")
  status      ProjectStatus   @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  avatarUrl   String?
  archivedAt  DateTime?
  members     ProjectMember[]
  columns     KanbanColumn[]
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProjectMember {
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(MEMBER)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@id([projectId, userId])
  @@index([userId])
}

model KanbanColumn {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  rank      String
  isDone    Boolean  @default(false)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@unique([projectId, rank])
  @@index([projectId])
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  columnId    String       @db.Uuid
  parentId    String?      @db.Uuid
  assigneeId  String?      @db.Uuid
  reporterId  String?      @db.Uuid
  code        String
  title       String
  description String       @default("")
  type        TaskType     @default(TASK)
  priority    TaskPriority @default(MEDIUM)
  rank        String
  labels      String[]     @default([])
  dueDate     DateTime?
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column      KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Restrict)
  parent      Task?        @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Task[]       @relation("TaskHierarchy")
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User?        @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  comments    Comment[]
  activities  Activity[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([projectId, code])
  @@unique([columnId, rank])
  @@index([projectId])
  @@index([parentId])
  @@index([assigneeId])
  @@index([reporterId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([authorId])
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  actorId   String   @db.Uuid
  field     String
  from      String?
  to        String?
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([actorId])
}
